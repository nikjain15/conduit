{
  "name": "conduit",
  "version": "0.1.0",
  "private": true,
  "description": "Conduit: the internal AI platform (routing, evals, RAG, agents, MCP) that products plug into. Hybrid: a control plane and distribution surface, plus embeddable in-process core packages.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cost:model": "node scripts/cost-model.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "license": "MIT",
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "vite": "^6.4.3",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
